# DATABASE CONFIGURATION (NeonDB PostgreSQL)
# ==========================================

DATABASE_URL=jdbc:postgresql://your-host.neon.tech/your_database?sslmode=require
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# CONNECTION POOL SETTINGS (HikariCP)
# ===================================

DB_POOL_MAX_SIZE=120
DB_POOL_MIN_IDLE=20
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# RMI SERVER CONFIGURATION
# ========================

RMI_SERVER_HOST=localhost
RMI_SERVER_PORT=1099

# SPRING BOOT API GATEWAY CONFIGURATION
# =====================================

SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000

# JWT AUTHENTICATION CONFIGURATION
# ================================

JWT_SECRET=your-jwt-secret-need-at-least-32-characters
JWT_EXPIRATION=86400000

# FRONTEND CONFIGURATION (Next.js)
# ================================

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:3000
