DATABASE_URL=jdbc:postgresql://localhost:5432/hrms       # DatabaseInitializer drops and recreates every table here
DB_USER=hrms
DB_PASSWORD=hrms
JWT_SECRET=your-jwt-secret-need-at-least-32-characters   # 32+ bytes; the gateway refuses this placeholder

# Optional. Values shown are the defaults.
RMI_SERVER_HOST=localhost
RMI_SERVER_PORT=1099
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000                        # Origin the gateway allows through CORS
JWT_EXPIRATION=86400000                                   # Milliseconds
DB_POOL_MAX_SIZE=120
DB_POOL_MIN_IDLE=20
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:3000
